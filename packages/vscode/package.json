{
  "name": "remotry",
  "displayName": "Remotry Deploy",
  "description": "Deploy projects to SSH servers (key, password, or ssh-agent) or network folders, with one-click rollback, from VSCode",
  "version": "1.1.0",
  "publisher": "develoverli",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/develoverli/remotry#readme",
  "bugs": {
    "url": "https://github.com/develoverli/remotry/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/develoverli/remotry.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "deploy",
    "deployment",
    "ssh",
    "sftp",
    "remote",
    "rollback"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/.deployrc",
    "onView:deployProjects",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "deploy.deploy",
        "title": "Deploy Project",
        "category": "Deploy",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "deploy.rollback",
        "title": "Roll Back...",
        "category": "Deploy",
        "icon": "$(history)"
      },
      {
        "command": "deploy.testConnection",
        "title": "Test Connection",
        "category": "Deploy",
        "icon": "$(plug)"
      },
      {
        "command": "deploy.register",
        "title": "Register / Edit Project",
        "category": "Deploy",
        "icon": "$(add)"
      },
      {
        "command": "deploy.status",
        "title": "Show Status",
        "category": "Deploy"
      },
      {
        "command": "deploy.list",
        "title": "List Projects",
        "category": "Deploy"
      },
      {
        "command": "deploy.remove",
        "title": "Remove Project",
        "category": "Deploy"
      },
      {
        "command": "deploy.showLog",
        "title": "Show Deploy Log",
        "category": "Deploy",
        "icon": "$(output)"
      },
      {
        "command": "deploy.refresh",
        "title": "Refresh",
        "category": "Deploy",
        "icon": "$(refresh)"
      },
      {
        "command": "deploy.openConfig",
        "title": "Open Config File",
        "category": "Deploy"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "deploy.list"
        },
        {
          "command": "deploy.register"
        },
        {
          "command": "deploy.deploy"
        },
        {
          "command": "deploy.rollback"
        },
        {
          "command": "deploy.testConnection"
        },
        {
          "command": "deploy.status"
        },
        {
          "command": "deploy.remove"
        },
        {
          "command": "deploy.openConfig"
        },
        {
          "command": "deploy.showLog"
        }
      ],
      "view/title": [
        {
          "command": "deploy.register",
          "when": "view == deployProjects",
          "group": "navigation@1"
        },
        {
          "command": "deploy.refresh",
          "when": "view == deployProjects",
          "group": "navigation@2"
        },
        {
          "command": "deploy.showLog",
          "when": "view == deployProjects",
          "group": "navigation@3"
        }
      ]
    },
    "views": {
      "deploy-activitybar": [
        {
          "type": "webview",
          "id": "deployProjects",
          "name": "Deploy Projects",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Remotry",
      "properties": {
        "deploy.sshKey": {
          "type": "string",
          "default": "~/.ssh/id_rsa",
          "description": "Default SSH private key"
        },
        "deploy.defaultRemoteUser": {
          "type": "string",
          "default": "root",
          "description": "Default SSH username"
        },
        "deploy.defaultRemoteBase": {
          "type": "string",
          "default": "/var/www",
          "description": "Default remote base path"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deploy-activitybar",
          "title": "Deploy",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm bundle:prod",
    "compile": "tsc -p ./ --noEmit && node build.mjs",
    "bundle": "node build.mjs",
    "bundle:prod": "node build.mjs --production",
    "watch": "node build.mjs --watch",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "@develoverli/remotry-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.80.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  }
}
