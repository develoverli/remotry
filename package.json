{
  "name": "remotry-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "Remotry monorepo — core deploy engine, CLI, and VSCode extension",
  "homepage": "https://github.com/develoverli/remotry#readme",
  "bugs": {
    "url": "https://github.com/develoverli/remotry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/develoverli/remotry.git"
  },
  "license": "MIT",
  "author": "develoverli",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @develoverli/remotry-core build",
    "build:cli": "pnpm --filter @develoverli/remotry-cli build",
    "build:vscode": "pnpm --filter remotry compile",
    "package:vscode": "pnpm --filter remotry package",
    "cli": "pnpm --filter @develoverli/remotry-cli start",
    "clean": "pnpm -r exec rm -rf dist out"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
